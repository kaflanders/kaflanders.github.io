html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f3f6ff;
    color: #222;
}

header {
    background: #283593;
    color: white;
    text-align: center;
    padding: 1rem;
}

nav {
    margin-top: 1rem;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 10px;
}

nav a:hover {
    text-decoration: underline;
}

main {
    display: grid;
    gap: 1.5rem;
    padding: 2rem;
}

.card {
    background: white;
    padding: 1.5rem;
    border-radius: 12px;
    box-shadow: 0 3px 10px rgba(0,0,0,.1);
    transition: transform .3s ease;
}

.card:hover {
    transform: translateY(-5px);
}

input,
select,
button {
    display: block;
    width: 100%;
    max-width: 400px;
    margin-bottom: 1rem;
    padding: .75rem;
}

button {
    background: #3949ab;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
}

button:hover {
    background: #5c6bc0;
}

button:focus,
input:focus,
select:focus,
a:focus {
    outline: 3px solid #ffb300;
}

footer {
    text-align: center;
    padding: 1rem;
    background: #283593;
    color: white;
}

.course {
    border: 1px solid #ddd;
    padding: 1rem;
    margin-bottom: 1rem;
}

@media (max-width: 768px) {
    nav {
        display: flex;
        flex-direction: column;
        gap: .5rem;
    }

    main {
        padding: 1rem;
    }
}
